  Access["Dashboards & Administration<br/>Provides navigation, secure routing, and management"]
  Knowledge["Engineering Source & Recovery Knowledge<br/>Preserves source, decisions, runbooks, and recovery evidence"]

  Docker --> CoreOps
  Docker --> Observe
  Docker --> Access
  WSL --> Knowledge

  subgraph Roadmap["Nova Intelligence Roadmap"]
    direction LR
    Core["Nova Core<br/>Builds a model-independent knowledge foundation"]
    Awareness["Nova Awareness<br/>Builds context about system state and activity"]
    Retrieval["RAG & Retrieval<br/>Finds relevant knowledge before Nova answers"]
    Agents["Agent Routing + MCP<br/>Chooses the right models and tools for a task"]
    Approval["Human-Approved Actions<br/>Requires approval before sensitive changes"]
    Core -.-> Retrieval
    Awareness -.-> Agents
    Retrieval -.-> Agents
    Agents -.-> Approval
  end

  Access -. "AI experimentation" .-> Roadmap
  Knowledge -. "evidence and design" .-> Roadmap

