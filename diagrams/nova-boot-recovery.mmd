%%{init: {"theme":"base","flowchart":{"htmlLabels":false,"curve":"basis","nodeSpacing":28,"rankSpacing":34},"themeVariables":{"background":"#070b19","primaryColor":"#172554","primaryTextColor":"#f8fafc","primaryBorderColor":"#22d3ee","lineColor":"#94a3b8","secondaryColor":"#2e1065","tertiaryColor":"#111827","edgeLabelBackground":"#111827","fontFamily":"Segoe UI, Inter, Arial, sans-serif","fontSize":"16px"}}}%%
flowchart TD
  Login["Windows Logon<br/>Starts the user-scoped boot sequence"]
  Task["Scheduled Task<br/>Waits 30 seconds, then launches once"]
  PowerShell["PowerShell Launcher<br/>Wakes WSL2 and propagates the final exit code"]
  Verifier["WSL2 Verifier<br/>Performs passive, read-only convergence checks"]
  Docker["Docker Readiness<br/>Waits up to 150 seconds for the engine"]
  VPN["VPN Safety / Dependency Gate<br/>Allows up to 90 seconds while preserving fail-closed safety"]
  Apps["Core Services<br/>Checks identity, mounts, routes, and application behavior"]
  Telemetry["Telemetry Convergence<br/>Allows up to 60 seconds for authoritative targets"]
  Healthy["Healthy Result<br/>Returns success with zero unexpected recreation"]
  Deadline["Global Deadline<br/>Bounds the complete verifier to 300 seconds"]

  Login --> Task --> PowerShell --> Verifier --> Docker --> VPN --> Apps --> Telemetry --> Healthy
  Deadline -. "bounds every wait" .-> Verifier

  classDef trigger fill:#172554,stroke:#22d3ee,color:#f8fafc,stroke-width:2px
  classDef gate fill:#312e81,stroke:#a78bfa,color:#f8fafc,stroke-width:2px
  classDef safety fill:#3b1d5b,stroke:#e879f9,color:#f8fafc,stroke-width:2px
  classDef success fill:#064e3b,stroke:#34d399,color:#f8fafc,stroke-width:2px
  classDef bound fill:#111827,stroke:#64748b,color:#cbd5e1,stroke-width:2px,stroke-dasharray:6 4

  class Login,Task,PowerShell,Verifier trigger
  class Docker,Apps,Telemetry gate
  class VPN safety
  class Healthy success
  class Deadline bound
